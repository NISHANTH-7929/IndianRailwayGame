{
  "type": "object",
  "properties": {
    "assetId": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Za-z0-9]+){2,}$"
    },
    "name": {
      "type": "string",
      "pattern": "^(SM|SK|DA|ABP|AS|SW|NS|T|M|WBP)_[A-Za-z0-9_]+$"
    },
    "category": {
      "enum": [
        "locomotive",
        "coach",
        "wagon",
        "formation",
        "station",
        "trackside",
        "environment",
        "building",
        "vegetation",
        "character",
        "animation",
        "audio",
        "vfx",
        "ui"
      ]
    },
    "state": {
      "enum": [
        "placeholder",
        "candidate",
        "accepted"
      ]
    },
    "sourceFormat": {
      "type": "string",
      "minLength": 1
    },
    "unrealPath": {
      "type": "string",
      "pattern": "^/Game/IndianRailway/"
    },
    "importType": {
      "type": "string",
      "minLength": 1
    },
    "scaleCmPerUnit": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "forward": {
      "enum": [
        "+X"
      ]
    },
    "up": {
      "enum": [
        "+Z"
      ]
    },
    "pivot": {
      "type": "string",
      "minLength": 1
    },
    "collision": {
      "enum": [
        "none",
        "query-proxy",
        "simple-proxy"
      ]
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "materialSlotLimit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "textures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^T_[A-Za-z0-9_]+_(BC|N|ORM|E|A)$"
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "maxDimension": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "group",
          "maxDimension"
        ],
        "additionalProperties": false
      }
    },
    "lods": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "materialLodProfile": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Za-z0-9]+){2,}$"
    },
    "chunk": {
      "type": "integer",
      "minimum": 1
    },
    "essential": {
      "type": "boolean"
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "Android",
          "Windows"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tiers": {
      "type": "array",
      "items": {
        "enum": [
          "Low",
          "Medium",
          "High"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Za-z0-9]+){2,}$"
      },
      "uniqueItems": true
    },
    "localizationKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "audioDependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Za-z0-9]+){2,}$"
      },
      "uniqueItems": true
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "enum": [
              "Android",
              "Windows"
            ]
          },
          "tier": {
            "enum": [
              "Low",
              "Medium",
              "High"
            ]
          },
          "unrealPath": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "platform",
          "tier",
          "unrealPath"
        ],
        "additionalProperties": false
      }
    },
    "external": {
      "type": "boolean"
    },
    "provenance": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "AssetId": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Za-z0-9]+){2,}$"
            },
            "AssetName": {
              "type": "string",
              "minLength": 1
            },
            "Category": {
              "enum": [
                "locomotive",
                "coach",
                "wagon",
                "formation",
                "station",
                "trackside",
                "environment",
                "building",
                "vegetation",
                "character",
                "animation",
                "audio",
                "vfx",
                "ui"
              ]
            },
            "Creator": {
              "type": "string",
              "minLength": 1
            },
            "Source": {
              "type": "string",
              "minLength": 1
            },
            "SourceReference": {
              "type": "string",
              "minLength": 1
            },
            "AcquisitionDate": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "License": {
              "type": "string",
              "minLength": 1
            },
            "CommercialUse": {
              "enum": [
                "verified",
                "denied",
                "unknown"
              ]
            },
            "ModificationPermission": {
              "enum": [
                "verified",
                "denied",
                "unknown"
              ]
            },
            "RedistributionRestrictions": {
              "type": "string",
              "minLength": 1
            },
            "AttributionRequirement": {
              "type": "string",
              "minLength": 1
            },
            "OriginalArchive": {
              "type": "string",
              "minLength": 1
            },
            "ModifiedAssetReference": {
              "type": "string",
              "minLength": 1
            },
            "VerificationStatus": {
              "enum": [
                "pending review",
                "approved",
                "rejected",
                "restricted",
                "unknown"
              ]
            },
            "VerificationEvidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "Notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "AssetId",
            "AssetName",
            "Category",
            "Creator",
            "Source",
            "SourceReference",
            "AcquisitionDate",
            "License",
            "CommercialUse",
            "ModificationPermission",
            "RedistributionRestrictions",
            "AttributionRequirement",
            "OriginalArchive",
            "ModifiedAssetReference",
            "VerificationStatus",
            "VerificationEvidence",
            "Notes"
          ],
          "additionalProperties": false,
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:indianrailway:s8:provenance"
        }
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "assetId",
    "name",
    "category",
    "state",
    "sourceFormat",
    "unrealPath",
    "importType",
    "scaleCmPerUnit",
    "forward",
    "up",
    "pivot",
    "collision",
    "materials",
    "materialSlotLimit",
    "textures",
    "lods",
    "materialLodProfile",
    "chunk",
    "essential",
    "platforms",
    "tiers",
    "dependencies",
    "localizationKeys",
    "audioDependencies",
    "variants",
    "external",
    "provenance",
    "owner"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:indianrailway:s8:asset"
}
