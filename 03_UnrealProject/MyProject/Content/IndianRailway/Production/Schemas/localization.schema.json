          },
          "en": {
            "type": "string",
            "minLength": 1
          },
          "hi": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "en",
          "hi"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "fontScaleOptions": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1
          },
          "minItems": 1
