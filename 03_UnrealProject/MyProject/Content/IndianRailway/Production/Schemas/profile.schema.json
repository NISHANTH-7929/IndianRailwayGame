{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "profileId": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Za-z0-9]+){2,}$"
    },
    "device": {
      "enum": [
        "iQOO Neo 9 Pro"
      ]
    },
    "androidApi": {
      "enum": [
        36
      ]
    },
    "abi": {
      "enum": [
        "arm64-v8a"
      ]
    },
    "renderer": {
      "enum": [
        "Vulkan"
      ]
    },
    "textureFormat": {
      "enum": [
        "ASTC"
      ]
    },
    "captureFrames": {
      "type": "integer",
      "minimum": 1
    },
    "warmupSeconds": {
      "type": "number",
      "minimum": 0
    },
    "endSeconds": {
      "type": "number",
      "minimum": 0
    },
    "frameCap": {
      "enum": [
        30
      ]
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 10
    },
    "workloadId": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Za-z0-9]+){2,}$"
    },
    "scope": {
      "enum": [
        "foundation-S7-fixture",
        "WAP7-LHB-service-WAP7",
        "WAP7-LHB-service-baseline",
        "WAP7-LHB-station-A",
        "WAP7-LHB-station-B"
      ]
    },
    "finalBudgetClaim": {
      "enum": [
        false
      ]
    }
  },
  "required": [
    "schemaVersion",
    "profileId",
    "device",
    "androidApi",
    "abi",
    "renderer",
    "textureFormat",
    "captureFrames",
    "warmupSeconds",
    "endSeconds",
    "frameCap",
    "repetitions",
    "metrics",
    "workloadId",
    "scope",
    "finalBudgetClaim"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:indianrailway:s8:profile"
}
